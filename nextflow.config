/*
  Nextflow configuration for single-cell RNA-seq (SRA → QC → STARsolo → Scanpy → DESeq2 → figures).
  Override paths and SLURM partition on your cluster via -c extra.config or env.
*/

params {
  samplesheet         = "${projectDir}/assets/samplesheet.csv"
  scripts_dir         = "${projectDir}/../Single_cell_tumour_data"
  outdir              = "${launchDir}/results_single_cell"
  tumor1_sample       = "Tumor1"
  tumor2_sample       = "Tumor2"
  normal_sample       = "NormalAdjacent"
  ref_fasta           = "${projectDir}/../refs/Sscrofa11.1.dna.fa"
  ref_gtf             = "${projectDir}/../refs/Sus_scrofa.Sscrofa11.1.gtf"
  star_whitelist      = "${projectDir}/../refs/3M-february-2018.txt"
  star_genome_dir     = "sscrofa_index"
  trim_cores          = 4
  pigz_threads        = 8
  star_index_threads  = 16
  star_align_threads  = 16
  slurm_partition     = "compute"
  slurm_account       = ""
}

profiles {
  standard {
    process.executor = "local"
  }
  slurm {
    process {
      executor       = "slurm"
      queue          = "${params.slurm_partition}"
      clusterOptions = "${params.slurm_account?.trim() ? '-A ' + params.slurm_account.trim() : ''}"
      scratch        = "/tmp"
      errorStrategy  = "finish"
      maxRetries     = 1
      cpus           = { task.cpus }
      memory         = { task.memory }
      time           = { task.time }
    }
  }
}

manifest {
  name        = "single_cell_scrna"
  description = "Sus scrofa scRNA-seq: download → trim → STARsolo → QC → integration → DE → plots"
  author      = "NF1_nextflow_pipeline"
  nextflowVersion = ">=23.04.0"
}
